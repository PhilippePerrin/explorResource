# Loaded only by `vite build --mode e2e` (see playwright.config.ts). Enables
# a window hook that lets Playwright seed fixture data through the real
# repository layer, since the app's SQLite database lives behind a Worker
# that page.evaluate can no longer reach directly. Never set in the release
# build served by Rebex Tiny Web Server.
VITE_E2E_TEST_HOOKS=1
